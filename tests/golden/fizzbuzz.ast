(fn
  fizz
  (params (n i32))
  (-> txt)
  (block
    (if
      (if (== (% n 15) 0) (block (ret "FizzBuzz")))
      (if (== (% n 3) 0) (block (ret "Fizz")))
      (if (== (% n 5) 0) (block (ret "Buzz")))
      (else (block (ret (str (interp n))))))))
(loop-in i (..= 1 15) (block (call print (call fizz i))))
