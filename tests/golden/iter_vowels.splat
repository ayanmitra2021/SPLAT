# Membership with a parenthesised list: `c in (c"a", c"e", ...)` desugars to equality tests.
fn count_vowels(text::txt)::i32:
    var n::i32 = 0
    loop c in text:
        if c in (c"a", c"e", c"i", c"o", c"u"):
            n += 1
        ;
    ;
    n
;

print count_vowels("hello its halloween!"), count_vowels(""), count_vowels("rhythm")
print c"e" in "aeiou", c"z" in "aeiou", "ell" in "hello", !("xyz" in "hello")
print 3 in (1, 2, 3), 4 in (1, 2, 3), "b" in ("a", "b")
