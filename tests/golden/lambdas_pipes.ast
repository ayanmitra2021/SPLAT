(bind inc (lambda (params x) (+ x 1)))
(bind add (lambda (params a b) (+ a b)))
(bind thunk (lambda (params) 42))
(bind r (call map xs (lambda (params v) (** v 2))))
(bind p (|> (|> xs (call map (lambda (params v) (* v 2)))) sum))
(bind f (call compose inc (lambda (params y) (- y 1)) (arg scale 2)))
(bind nested (lambda (params x) (lambda (params y) (+ x y))))
(bind n (lambda (params x) (norm 2 x)))
(bind both (or (norm 2 a) (norm 2 b)))
(bind cmp (lambda (params a) (and (< a 3) (> a 0))))
(bind net (>> (>> (>> (call lin In 64) gelu) (call dropout 0.1)) (call lin 64 Out)))
