# Phase 13: A \ b solves a linear system. Square systems use LU with partial pivoting;
# tall systems are solved in the least-squares sense (QR); wide systems give the minimum-norm solution.
A::f64[3, 3] = f64[[2, 1, -1], [-3, -1, 2], [-2, 1, 2]]
b::f64[3] = f64[8, -11, -3]
x := A \ b
print "{x:.6}"
print "{A @ x:.6}"
print ||A @ x - b|| < 1e-9

# A system that needs a row swap (zero in the first pivot).
P::f64[2, 2] = f64[[0, 1], [1, 0]]
print P \ f64[3, 4]

# Several right-hand sides at once.
I2 := A \ eye(3)
print ||A @ I2 - eye(3)|| < 1e-9

# Least squares: fit y = c0 + c1 * t to four points.
t := f64[0, 1, 2, 3]
y := f64[1, 3, 5, 7]
D::f64[4, 2] = f64[[1, 0], [1, 1], [1, 2], [1, 3]]
coef := D \ y
print "{coef:.6}"

# Minimum norm: x + y = 2 has many answers; the shortest is (1, 1).
W::f64[1, 2] = f64[[1, 1]]
print "{W \ f64[2]:.6}"

# f32 works too.
F::f32[2, 2] = f32[[4, 1], [1, 3]]
r := F \ f32[1, 2]
print ||F @ r - f32[1, 2]|| < 0.0001
