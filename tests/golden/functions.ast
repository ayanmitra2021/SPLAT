(fn apply (generics T) (params (f (fn-type (params T) T)) (v T)) (-> T) (= (call f v)))
(fn
  norm_all
  (generics $R $C)
  (params (m (tensor f32 $R $C)) (k (Maybe (Maybe i32))))
  (-> (tensor f32 ? 3))
  (= m))
(fn scale (params self (by f32 1.5)) (-> f32) (block (ret by)))
(fn peek_it (params &self) (-> unit) (= ()))
(fn poke_it (params ~self) (-> unit) (= ()))
(fn op + (params self (other Vec2)) (-> Vec2) (= other))
(fn op [] (params self (i usize)) (-> f32) (= 0.0))
(bind r (|> (|> 3 double) add_one))
(bind a (index A : (.. 0 3)))
(bind b (. (index (. obj items) 0) name))
(bind c (- (** 2 2)))
(var m (: (Maybe i32)) (call f))
