# guess / judge, model calls with peeks, and expressions with a string template
model := guess(ridge = 0.05) fit (X, y)
lin := guess(linear) fit (X[:, 0..3], y)
clf := judge(svm(kernel = "rbf", c = 1.0)) fit (X, y)
pred := model(&X_test)
score := clf.acc(&X_test, &y_test)
poly := guess(poly(degree = 3), ridge = 0.1) fit (X, y)
msg := "r2 = {model.r2(&X, &y):.3} and loss {||u - v||:.2}"
cook train(X::mid[$N, $F], y::mid[$N])::mid = guess(ridge = 1e-2) fit (X, y)(&X)
