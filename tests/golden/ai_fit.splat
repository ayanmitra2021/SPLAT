# regress / classify, model calls with peeks, and expressions with a string template
model := regress(ridge = 0.05) fit (X, y)
lin := regress(linear) fit (X[:, 0..3], y)
clf := classify(svm(kernel = "rbf", c = 1.0)) fit (X, y)
pred := model(&X_test)
score := clf.acc(&X_test, &y_test)
poly := regress(poly(degree = 3), ridge = 0.1) fit (X, y)
msg := "r2 = {model.r2(&X, &y):.3} and loss {||u - v||:.2}"
fn fit_ridge(X::f32[$N, $F], y::f32[$N])::f32 = regress(ridge = 1e-2) fit (X, y)(&X)
