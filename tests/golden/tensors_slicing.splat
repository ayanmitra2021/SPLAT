# Phase 12: indexing, slicing (views), assignment, iteration, membership, CSV.
M::f32[3, 4] = reshape(arange(12), 3, 4)
print M
print M[1, 2]
print M[1]
print M[:, 0]
print M[0..2, 1..3]
print M[:, 0..=3 by 2]

# A slice written through a `var` changes the original: slices are views.
var T::f32[2, 3] = zeros(2, 3)
T[0, 1] = 5.0
T[1, :] = f32[7, 8, 9]
T[:, 0] = 1.0
T[0, 2] += 0.5
print T

# Binding a named tensor copies it; binding a slice keeps the view.
var copy = T
copy[0, 0] = 100.0
print T[0, 0]
print copy[0, 0]

# Rows iterate as views; a vector iterates as numbers.
loop row in M:
    print row
;
loop x in f32[10, 20, 30]:
    print x + 1.0
;
loop i, row in enumerate(f32[[1, 2], [3, 4]]):
    print "{i}: {row}"
;
loop a, b in zip(f32[1, 2, 3], f32[4, 5, 6]):
    print a * b
;

# Membership of a scalar.
print 3.0 in M
print 99.0 in M
print 2.0 in f32[1, 2, 3]

# CSV round trip (tensors in, tensors out).
save_csv("m3_slicing_tmp.csv", f32[[1.5, 2.0], [3.0, 4.25]])
back := load_csv("m3_slicing_tmp.csv")
print back
print back == f32[[1.5, 2.0], [3.0, 4.25]]
delete("m3_slicing_tmp.csv")
