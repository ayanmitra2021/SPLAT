# Closures: a counter with private state, a higher-order function, and lambdas
fn make_counter(start::i32)::fn()::i32:
    var n = start
    fn next()::i32:
        n += 1
        ret n
    ;
    ret next
;

fn twice(f::fn(i32)::i32, x::i32)::i32 = f(f(x))
fn adder(k::i32)::fn(i32)::i32 = |x| x + k

a := make_counter(0)
b := make_counter(100)
print a(), a(), a()
print b(), a(), b()

print twice(|x| x * 3, 7)
add5 := adder(5)
print add5(10), 10 |> add5 |> add5
inc := |x::i64| x + 1
print inc(41)
