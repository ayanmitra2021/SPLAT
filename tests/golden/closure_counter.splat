# Closures: a counter with private state, a higher-order function, and lambdas
cook make_counter(start::i32)::cook()::i32:
    wag n = start
    cook next()::i32:
        n += 1
        yeet n
    ;
    yeet next
;

cook twice(f::cook(i32)::i32, x::i32)::i32 = f(f(x))
cook adder(k::i32)::cook(i32)::i32 = |x| x + k

a := make_counter(0)
b := make_counter(100)
squish a(), a(), a()
squish b(), a(), b()

squish twice(|x| x * 3, 7)
add5 := adder(5)
squish add5(10), 10 |> add5 |> add5
inc := |x::i64| x + 1
squish inc(41)
