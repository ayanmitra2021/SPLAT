# Stepped and reversed ranges; `by` and `rev` work with inclusive ranges and in membership tests too.
var out = ""
loop i in 0..10 by 3:
    out = out + "{i} "
;
print "by 3:       {out}"

out = ""
loop i in 0..=10 by 5:
    out = out + "{i} "
;
print "..= by 5:   {out}"

out = ""
loop i in rev(0..5):
    out = out + "{i} "
;
print "rev:        {out}"

out = ""
loop i in rev(0..10 by 4):
    out = out + "{i} "
;
print "rev by 4:   {out}"

out = ""
loop i in 5..5:
    out = out + "{i} "
;
print "empty:      [{out}]"

step := 7
var sum_of_steps = 0
loop i in 0..100 by step:
    sum_of_steps += i
;
print "by a variable: {sum_of_steps}"

print 4 in 0..10 by 2, 5 in 0..10 by 2, 10 in 0..10, 10 in 0..=10, 10 in 0..=10 by 5
print 0..10 by 2, rev(1..=4)
big::i64 = 3_000_000_000
var steps::i64 = 0
loop n in big..big + 10 by 4:
    steps += 1
;
print "i64 range took {steps} steps"
