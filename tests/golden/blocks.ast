(fn add (params (a i32) (b i32 2)) (-> i32) (= (+ a b)))
(fn
  walk
  (params (n i32))
  (-> i32)
  (block
    (var total 0)
    (loop-in i (.. 0 n) (block (loop-in j (..= 0 i) (block (+= total (* i j))))))
    (ret total)))
(bind x (call add 1))
(bind y (: f32) 2.5)
(var z (: i64) 7)
(-= z 3)
(call print (str "total " (interp (call walk 4)) " and " (interp y ".3")))
(call eprint "careful" x)
