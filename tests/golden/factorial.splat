# Factorial, recursive and iterative, with checked i64 arithmetic
fn fact(n::i64)::i64:
    if n <= 1:
        ret 1
    el:
        ret n * fact(n - 1)
    ;
;

fn fact_loop(n::i64)::i64:
    var acc::i64 = 1
    loop i in 2..=n:
        acc *= i
    ;
    acc
;

loop n in 0..=10:
    print "{n}! = {fact(i64(n))}"
;
print "20! = {fact(20)}"
print "loop agrees: {fact_loop(20) == fact(20)}"
