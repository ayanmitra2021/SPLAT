(fn
  describe
  (params (n i32))
  (-> txt)
  (block
    (if
      (if (< n 0) (block (ret "negative")))
      (if (== n 0) (block (ret "zero")))
      (if (and (< n 10) (== (% n 2) 0)) (block (ret "small even")))
      (else (block (ret "other"))))))
(var i 0)
(loop-while
  (< i 20)
  (block
    (+= i 1)
    (if (if (== (% i 2) 0) (block (cont))))
    (if (if (> i 7) (block (br))))
    (call print (call describe i))))
(loop (block (br)))
