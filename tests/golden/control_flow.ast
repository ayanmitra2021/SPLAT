(cook
  classify
  (params (n i32))
  (-> txt)
  (block
    (hmm
      (if (< n 0) (block (yeet "negative")))
      (if (== n 0) (block (yeet "zero")))
      (if (and (< n 10) (== (% n 2) 0)) (block (yeet "small even")))
      (else (block (yeet "other"))))))
(wag i 0)
(spin-while
  (< i 20)
  (block
    (+= i 1)
    (hmm (if (== (% i 2) 0) (block (skip))))
    (hmm (if (> i 7) (block (bail))))
    (call squish (call classify i))))
(spin (block (bail)))
