# Fibonacci: naive recursion, an iterative version, and a pipe
fn fib(n::i32)::i32:
    if n < 2:
        ret n
    ;
    fib(n - 1) + fib(n - 2)
;

fn fib_iter(n::i32)::i64:
    var a::i64 = 0
    var b::i64 = 1
    loop i in 0..n:
        t := a + b
        a = b
        b = t
    ;
    a
;

print "fib(20) = {fib(20)}"
print "fib_iter(50) = {fib_iter(50)}"
print "piped: {10 |> fib}"
