# Core collections: List, Set, Map and tuples, with iteration, membership and chains.

# ---- List ----
var xs = [3, 1, 2]
xs.push(4)
xs.insert(0, 9)
print xs, len(xs), xs[0], xs[1..3], xs + [7, 7]
last := xs.pop()
print last, xs
removed := xs.remove(1)
print removed, xs
xs[0] = 100
xs[1] += 5
print xs
print([1, 2] == [1, 2], [1, 2] == [2, 1])

# pop on an empty list is Nada, never a crash
var empty::List<i32> = []
print empty.pop(), len(empty)

# split and lines give lists of txt
words := split("the quick brown fox", ",")
print words, len(words)
print lines("a\nb\nc"), len(lines("a\nb\nc"))
print split("the quick brown fox", " ")

# Assigning a list copies it (until ownership arrives in Phase 17)
var copy = xs
copy.push(0)
print len(xs), len(copy)

# ---- Set: insertion-ordered, O(1) membership ----
s := set(3, 1, 3, 2)
print s, len(s), 2 in s, 9 in s
var seen = set(1)
seen.add(5)
seen.add(1)
print seen, seen.remove(5), seen.remove(5), seen

# ---- Map: insertion-ordered, k in map tests keys ----
var scores = map("ada" => 90, "alan" => 85)
scores["grace"] = 99
scores["ada"] += 5
print scores, scores["ada"], len(scores)
print "alan" in scores, "zed" in scores
print scores.get("zed"), scores.get("ada")
print scores.remove("alan"), scores.remove("alan"), len(scores)

# ---- Tuples ----
pair := (1, "one", true)
(n, name, flag) := pair
print pair, n, name, flag
print((1, "a") == (1, "a"), (1, "a") == (1, "b"))

# ---- Iteration ----
loop x in [10, 20, 30]:
    print x
;
loop k, v in scores:
    print "{k}: {v}"
;
loop i, w in enumerate(["a", "b", "c"]):
    print i, w
;
loop p in zip([1, 2, 3], ["one", "two"]):
    print p
;
loop n2 in rev([1, 2, 3]):
    print n2
;
loop x in set(5, 6):
    print x
;

# then chains work over lists, and mix with ranges of the same element type
loop x in [1, 2] then [10, 20] then 100..102:
    print x
;
total := 0
var sum_so_far = total
loop x in xs:
    sum_so_far += x
;
print "sum", sum_so_far

# ---- Membership ----
print 3 in [1, 2, 3], 4 in [1, 2, 3], c"e" in "hello", "ell" in "hello"
print 2 in (1, 2, 3), 5 in 0..10, 5 in 0..10 by 2
