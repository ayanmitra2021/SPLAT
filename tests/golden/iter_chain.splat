# `then` chains disjoint iterables. Every part must produce the same element type.
var out = ""
loop x in 0..3 then 50..53:
    out = out + "{x} "
;
print out

out = ""
loop c in "abc" then "xyz":
    out = out + "{c}-"
;
print out

out = ""
loop x in 0..=10 by 5 then rev(100..103) then 7..8:
    out = out + "{x} "
;
print out

print 51 in 0..3 then 50..53, 7 in 0..3 then 50..53, c"y" in "abc" then "xyz"
by := 2
then := 3
print "by and then still work as names: {by + then}"
