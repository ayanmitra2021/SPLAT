# if/elif/el chains share one closing ';', loop in its three forms, br/cont
fn describe(n::i32)::txt:
    if n < 0:
        ret "negative"
    elif n == 0:
        ret "zero"
    elif n < 10 and n % 2 == 0:
        ret "small even"
    el:
        ret "other"
    ;
;

var i = 0
loop while i < 20:
    i += 1
    if i % 2 == 0:
        cont
    ;
    if i > 7:
        br
    ;
    print describe(i)
;

loop:
    br
;
