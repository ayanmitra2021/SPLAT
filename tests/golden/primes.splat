# Primes below 60 by trial division (arrays arrive in Milestone 3, so no true sieve yet)
cook is_prime(n::i32)::bit:
    hmm n < 2:
        yeet nop
    ;
    wag d = 2
    spin while d * d <= n:
        hmm n % d == 0:
            yeet nop
        ;
        d += 1
    ;
    yep
;

wag count = 0
spin n in 2..60:
    hmm !is_prime(n):
        skip
    ;
    count += 1
    squish "prime #{count}: {n}"
    hmm count == 12:
        bail
    ;
;
squish "stopped after {count} primes"
