# Primes below 60 by trial division (arrays arrive in Milestone 3, so no true sieve yet)
fn is_prime(n::i32)::bool:
    if n < 2:
        ret false
    ;
    var d = 2
    loop while d * d <= n:
        if n % d == 0:
            ret false
        ;
        d += 1
    ;
    true
;

var count = 0
loop n in 2..60:
    if !is_prime(n):
        cont
    ;
    count += 1
    print "prime #{count}: {n}"
    if count == 12:
        br
    ;
;
print "stopped after {count} primes"
