(bind model (regress (config (arg ridge 0.05)) X y))
(bind lin (regress (config linear) (index X : (.. 0 3)) y))
(bind clf (classify (config (call svm (arg kernel "rbf") (arg c 1.0))) X y))
(bind pred (call model (& X_test)))
(bind score (call (. clf acc) (& X_test) (& y_test)))
(bind poly (regress (config (call poly (arg degree 3)) (arg ridge 0.1)) X y))
(bind
  msg
  (str
    "r2 = "
    (interp (call (. model r2) (& X) (& y)) ".3")
    " and loss "
    (interp (norm 2 (- u v)) ".2")))
(fn
  fit_ridge
  (params (X (tensor f32 $N $F)) (y (tensor f32 $N)))
  (-> f32)
  (= (call (regress (config (arg ridge 0.01)) X y) (& X))))
