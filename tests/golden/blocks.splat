# Nested blocks, ';;' multi-close, single-expression bodies, typed binds
fn add(a::i32, b::i32 = 2)::i32 = a + b

fn walk(n::i32)::i32:
    var total = 0
    loop i in 0..n:
        loop j in 0..=i:
            total += i * j
        ;;
    ret total
;

x := add(1)
y::f32 = 2.5
var z::i64 = 7
z -= 3
print "total {walk(4)} and {y:.3}"
eprint "careful", x
