# Nested blocks, ';;' multi-close, single-expression bodies, typed binds
cook add(a::i32, b::i32 = 2)::i32 = a + b

cook walk(n::i32)::i32:
    wag total = 0
    spin i in 0..n:
        spin j in 0..=i:
            total += i * j
        ;;
    yeet total
;

x := add(1)
y::mid = 2.5
wag z::i64 = 7
z -= 3
squish "total {walk(4)} and {y:.3}"
yell "careful", x
