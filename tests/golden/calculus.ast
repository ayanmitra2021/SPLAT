(bind area (intg (ranges (.. 0 1)) (lambda (params x) (** x 2))))
(bind area2 (intg (ranges (.. 0 3.14159)) (lambda (params x) (call sin x))))
(bind vol (intg (ranges (.. 0 1) (.. 0 2)) (opts (arg tol 1E-06)) (lambda (params x y) (* x y))))
(bind dg (grad f x))
(bind dg2 (grad (lambda (params t) (** t 3)) w))
(bind total (sum i (.. 0 10) (* i i)))
(bind ascii (sum i (.. 0 N) (* (index A i) (index B i))))
(bind fact (prod k (..= 1 n) k))
(bind nested (sum i (.. 0 n) (sum j (.. 0 m) (index A i j))))
(bind mixed (+ (* 2 (sum i (.. 0 3) i)) 1))
(bind l2 (norm 2 v))
(bind l1 (norm 1 v))
(bind linf (norm inf v))
(bind fro (** (norm F A) 2))
(bind dist (< (norm 2 (- u v)) 0.5))
(bind total2 (+ (call sum v) (call prod w)))
