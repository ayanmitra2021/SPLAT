<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Splat.Core\Splat.Core.csproj" />
    <ProjectReference Include="..\..\src\Splat.Syntax\Splat.Syntax.csproj" />
    <ProjectReference Include="..\..\src\Splat.Semantics\Splat.Semantics.csproj" />
    <ProjectReference Include="..\..\src\Splat.Runtime\Splat.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Splat.CodeGen\Splat.CodeGen.csproj" />
    <ProjectReference Include="..\..\src\Splat.Cli\Splat.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\golden\**\*.*" Link="golden\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\m1_acceptance.*" Link="m1\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\m2_acceptance.*" Link="m1\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>